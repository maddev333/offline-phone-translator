PORT=3000
NODE_ENV=development
AZURE_OPENAI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-realtime-mini
AZURE_OPENAI_USE_ENTRA_ID=true
AZURE_OPENAI_API_KEY=
REALTIME_VOICE=alloy
REALTIME_VAD_THRESHOLD=0.5
REALTIME_VAD_PREFIX_PADDING_MS=300
REALTIME_VAD_SILENCE_DURATION_MS=500
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-org.github.io
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-backend-app-registration-client-id
ENTRA_AUDIENCE=api://your-backend-app-registration-client-id
MCP_SERVER_URL=https://learn.microsoft.com/api/mcp
